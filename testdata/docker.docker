# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS builder

LABEL org.opencontainers.image.source="https://example.invalid/repo"
ARG VERSION=dev
ENV CGO_ENABLED=0 GOOS=linux

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN set -eux; \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/app ./cmd/app; \
    /out/app --version

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && \
    adduser -D -u 10001 app
USER app
COPY --from=builder /out/app /usr/local/bin/app
VOLUME ["/data"]
EXPOSE 8080/tcp
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s CMD ["app", "healthcheck"]
SHELL ["/bin/sh", "-c"]
ONBUILD COPY . /app
ENTRYPOINT ["app"]
CMD ["--serve"]
